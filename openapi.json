{
  "components": {
    "schemas": {
      "ChannelStatus": {
        "properties": {
          "channel_id": {
            "type": "integer"
          },
          "channel_name": {
            "type": "string"
          },
          "is_complete": {
            "type": "boolean"
          },
          "message_count": {
            "type": "integer"
          },
          "newest_message_id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "oldest_message_id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "channel_id",
          "channel_name",
          "is_complete",
          "message_count",
          "newest_message_id",
          "oldest_message_id"
        ],
        "title": "ChannelStatus",
        "type": "object"
      },
      "Greeting": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Greeting",
        "type": "object"
      },
      "HealthCheck": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "type": "string"
          }
        },
        "required": [],
        "title": "HealthCheck",
        "type": "object"
      },
      "IngestStatus": {
        "properties": {
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelStatus"
            },
            "type": "array"
          },
          "heartbeat": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WorkerHeartbeat"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_messages": {
            "type": "integer"
          }
        },
        "required": [
          "channels",
          "heartbeat",
          "total_messages"
        ],
        "title": "IngestStatus",
        "type": "object"
      },
      "WorkerHeartbeat": {
        "properties": {
          "beat_at": {
            "format": "date-time",
            "type": "string"
          },
          "session_started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "beat_at",
          "session_started_at"
        ],
        "title": "WorkerHeartbeat",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKey": {
        "description": "Injected server-side by nginx for the frontend; supplied directly by third-party clients.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Dashboard Discord API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "deprecated": false,
        "operationId": "ApiHealthHealthCheck",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheck"
                }
              }
            },
            "description": "Request fulfilled, document follows",
            "headers": {}
          }
        },
        "summary": "HealthCheck"
      }
    },
    "/api/hello": {
      "get": {
        "deprecated": false,
        "operationId": "ApiHelloHello",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            },
            "description": "Request fulfilled, document follows",
            "headers": {}
          }
        },
        "security": [
          {
            "APIKey": []
          }
        ],
        "summary": "Hello"
      }
    },
    "/api/ingest/status": {
      "get": {
        "deprecated": false,
        "operationId": "ApiIngestStatusIngestStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestStatus"
                }
              }
            },
            "description": "Request fulfilled, document follows",
            "headers": {}
          }
        },
        "security": [
          {
            "APIKey": []
          }
        ],
        "summary": "IngestStatus"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
