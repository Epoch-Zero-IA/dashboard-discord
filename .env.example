# Point d'entrée de l'application, lu par la CLI Litestar.
# Requis : l'autodiscovery ne cherche que app.py/application.py à la racine.
LITESTAR_APP=backend.app:app

# Clé attendue par le guard de /api/hello. nginx l'injecte côté serveur en
# production, le proxy Vite en développement : elle n'entre jamais dans le bundle.
# Requise — sans elle, la route refuse tout et `docker compose up` s'arrête.
API_KEY=dev-only-change-me

# URL du backend, lue par litestar-vite-plugin pour son diagnostic de dev.
# Sans elle, le dev server affiche un avertissement « backend absent » trompeur.
APP_URL=http://127.0.0.1:8000

# Sert la documentation OpenAPI sur /schema (Swagger, Redoc, openapi.json).
# Lu par backend/__init__.py. Défaut : true — désactivé dans compose.prod.yml,
# car /schema publie l'inventaire complet des routes.
#ENABLE_DOCS=false

# Nombre de workers Granian, lu par la CLI. C'est le levier de dimensionnement
# vertical de l'API. Défaut : 1
#WEB_CONCURRENCY=4

# Port du dev server Vite. Lu par frontend/vite.config.ts. Défaut : 5173
#VITE_PORT=5173

# Cible du proxy /api du dev server Vite, si l'API n'écoute pas sur le port
# habituel. Lu par frontend/vite.config.ts. Défaut : http://127.0.0.1:8000
#API_URL=http://127.0.0.1:8000

# Base de données, lue par core/config.py. L'hôte est 127.0.0.1 : cette valeur sert
# aux outils qui tournent sur la machine (alembic, pytest, `just dev-bot`). Dans
# compose, l'URL est reconstruite avec l'hôte `db`, qui n'existe que sur le réseau
# compose. Requise.
DATABASE_URL=postgresql+asyncpg://dashboard:dev-only-change-me@127.0.0.1:5432/dashboard_discord

# Base des tests marqués `db`. Doit nommer une base à elle : le harnais la migre.
# Aucun repli sur DATABASE_URL — un défaut serviable ferait vider la base de
# développement au premier `pytest`.
TEST_DATABASE_URL=postgresql+asyncpg://dashboard:dev-only-change-me@127.0.0.1:5432/dashboard_discord_test

# Mot de passe du service db de compose. Requis : `:?` bloque `docker compose up`.
POSTGRES_PASSWORD=dev-only-change-me

# Utilisateur et base du service db. Défauts : dashboard / dashboard_discord.
#POSTGRES_USER=dashboard
#POSTGRES_DB=dashboard_discord

# Token du bot Discord, lu par bot/. Régime de l'API_KEY : échec en fermé, jamais
# dans le bundle, jamais dans un log. Sans valeur ici, à remplir dans .env.
DISCORD_TOKEN=

# Rétention des messages bruts en jours, lue par core/config.py. L'agrégat de
# daily_activity survit à la purge. Défaut : 90
#MESSAGE_RETENTION_DAYS=90
